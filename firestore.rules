rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/clients/{clientId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /meetings/{meetingId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
